<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Termux" parent="Theme.MaterialComponents.NoActionBar">
        <!-- Colors -->
        <item name="colorPrimary">@color/color_accent_primary</item>
        <item name="colorPrimaryVariant">@color/color_surface_high</item>
        <item name="colorOnPrimary">@color/color_background</item>
        <item name="colorSecondary">@color/color_accent_secondary</item>
        <item name="colorOnSecondary">@color/color_text_primary</item>
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorOnSurface">@color/color_text_primary</item>
        <item name="android:colorBackground">@color/color_background</item>
        <item name="android:windowBackground">@color/color_background</item>

        <!-- Status and navigation bars -->
        <item name="android:statusBarColor">@color/color_background</item>
        <item name="android:navigationBarColor">@color/color_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>

        <!-- Window transitions -->
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>

        <!-- Shape appearance -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.TermuxMod.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.TermuxMod.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.TermuxMod.Large</item>

        <!-- Bottom sheet -->
        <item name="bottomSheetDialogTheme">@style/Style.TermuxMod.BottomSheet</item>

        <!-- Preference theme -->
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.v14.Material</item>

        <!-- Ripple -->
        <item name="rippleColor">@color/color_ripple</item>
    </style>

    <style name="Theme.Termux.Black" parent="Theme.Termux">
        <item name="android:colorBackground">@color/black</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
    </style>

    <!-- Shape Appearances -->
    <style name="ShapeAppearance.TermuxMod.Small" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_sm</item>
    </style>

    <style name="ShapeAppearance.TermuxMod.Medium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_md</item>
    </style>

    <style name="ShapeAppearance.TermuxMod.Large" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_lg</item>
    </style>

    <!-- Bottom Sheet Style -->
    <style name="Style.TermuxMod.BottomSheet" parent="Theme.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Style.TermuxMod.BottomSheetModal</item>
    </style>

    <style name="Style.TermuxMod.BottomSheetModal" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="android:background">@color/transparent</item>
        <item name="backgroundTint">@color/color_surface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.TermuxMod.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.TermuxMod.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/radius_lg</item>
        <item name="cornerSizeTopRight">@dimen/radius_lg</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Toolbar Title -->
    <style name="Toolbar.Title" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <!-- Splash Screen — dark background tanpa flicker putih (API 12+, tanpa dependency tambahan) -->
    <style name="Theme.Termux.Splash" parent="Theme.Termux">
        <item name="android:windowBackground">@color/color_background</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Divider -->
    <style name="ViewDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">@dimen/space_md</item>
        <item name="android:layout_marginBottom">@dimen/space_md</item>
        <item name="android:background">@color/color_border</item>
    </style>

</resources>
