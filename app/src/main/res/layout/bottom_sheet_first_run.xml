<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/space_lg">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_marginBottom="@dimen/space_md"
        android:background="@drawable/shape_drag_handle" />

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/onboarding_pager"
        android:layout_width="match_parent"
        android:layout_height="220dp" />

    <LinearLayout
        android:id="@+id/onboarding_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_md"
        android:layout_marginBottom="@dimen/space_md"
        android:orientation="horizontal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_md"
        android:paddingEnd="@dimen/space_md">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_onboarding_skip"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/onboarding_btn_skip"
            android:textColor="@color/color_text_secondary"
            app:rippleColor="@color/color_ripple" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_onboarding_next"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/onboarding_btn_next"
            app:backgroundTint="@color/color_accent_primary"
            android:textColor="@color/color_background"
            app:cornerRadius="@dimen/radius_sm"
            app:rippleColor="@color/color_background" />

    </LinearLayout>

</LinearLayout>
