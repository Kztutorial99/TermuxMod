<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:background="?attr/selectableItemBackground">

    <!-- Package icon: green rounded box with download arrow -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="44dp"
        android:layout_height="44dp"
        app:cardBackgroundColor="@color/color_ripple"
        app:cardElevation="0dp"
        app:cardCornerRadius="10dp"
        app:strokeColor="@color/color_accent_primary"
        app:strokeWidth="1dp"
        android:layout_marginEnd="14dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_nav_packages"
            android:tint="@color/color_accent_primary"
            android:scaleType="center"
            android:padding="10dp" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Name + version + description -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/pkg_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/color_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pkg_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/color_accent_primary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/pkg_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/color_text_secondary"
            android:textSize="12sp"
            android:maxLines="2" />

    </LinearLayout>

    <!-- Install/Uninstall button + progress indicator (menyatu di kanan) -->
    <LinearLayout
        android:layout_width="96dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:orientation="vertical"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pkg_action_btn"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="@string/packages_install"
            android:textSize="11sp"
            android:textColor="@color/color_accent_primary"
            app:strokeColor="@color/color_accent_primary"
            app:cornerRadius="8dp" />

        <ProgressBar
            android:id="@+id/pkg_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:indeterminate="true"
            android:progressTint="@color/color_accent_primary"
            android:indeterminateTint="@color/color_accent_primary"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
