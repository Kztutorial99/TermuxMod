<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/right_drawer"
    android:layout_width="268dp"
    android:layout_height="match_parent"
    android:layout_gravity="end"
    android:background="@color/color_surface_high"
    android:orientation="vertical"
    android:descendantFocusability="blocksDescendants">

    <!-- ── Header ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:background="@color/color_background">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/sidebar_title"
            android:textColor="@color/color_accent_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <ImageButton
            android:id="@+id/btn_close_right_drawer"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/color_text_secondary"
            android:contentDescription="Close sidebar" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/color_border" />

    <!-- ── Scrollable content ── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbarStyle="outsideOverlay">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- ════════════ SYSTEM INFO ════════════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sidebar_section_sysinfo"
                android:textColor="@color/color_accent_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.14"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="6dp" />

            <!-- Android version -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sidebar_android_version"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/sidebar_info_android"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_text_primary"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:text="..." />
            </LinearLayout>

            <!-- CPU Architecture -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sidebar_arch"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/sidebar_info_arch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_text_primary"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:text="..." />
            </LinearLayout>

            <!-- Free Storage -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sidebar_storage"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/sidebar_info_storage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_text_primary"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:text="..." />
            </LinearLayout>

            <!-- Prefix size -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sidebar_prefix"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/sidebar_info_prefix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_text_primary"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:text="..." />
            </LinearLayout>

            <!-- Active sessions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sidebar_sessions"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/sidebar_info_sessions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_accent_primary"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:text="0" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="2dp"
                android:background="@color/color_border" />

            <!-- ════════════ QUICK ACTIONS ════════════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sidebar_section_actions"
                android:textColor="@color/color_accent_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.14"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="4dp" />

            <!-- New Session -->
            <LinearLayout
                android:id="@+id/sidebar_action_new_session"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_new_session"
                    android:tint="@color/color_accent_primary"
                    android:layout_marginEnd="16dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/action_new_session"
                    android:textColor="@color/color_text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Kill Current Session -->
            <LinearLayout
                android:id="@+id/sidebar_action_kill_session"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_notification_stop"
                    android:tint="@color/color_accent_error"
                    android:layout_marginEnd="16dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sidebar_kill_session"
                    android:textColor="@color/color_accent_error"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Toggle Keyboard -->
            <LinearLayout
                android:id="@+id/sidebar_action_keyboard"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_arrow_up"
                    android:tint="@color/color_text_primary"
                    android:layout_marginEnd="16dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/action_toggle_soft_keyboard"
                    android:textColor="@color/color_text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Reset Terminal -->
            <LinearLayout
                android:id="@+id/sidebar_action_reset"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_refresh"
                    android:tint="@color/color_text_secondary"
                    android:layout_marginEnd="16dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/action_reset_terminal"
                    android:textColor="@color/color_text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="2dp"
                android:background="@color/color_border" />

            <!-- ════════════ APP SETTINGS ════════════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sidebar_section_app"
                android:textColor="@color/color_accent_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.14"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="4dp" />

            <!-- Terminal Appearance -->
            <LinearLayout
                android:id="@+id/sidebar_action_appearance"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_terminal"
                    android:tint="@color/color_accent_secondary"
                    android:layout_marginEnd="16dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sidebar_appearance"
                    android:textColor="@color/color_text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Settings -->
            <LinearLayout
                android:id="@+id/sidebar_action_settings"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_settings"
                    android:tint="@color/color_text_primary"
                    android:layout_marginEnd="16dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_activity_title"
                    android:textColor="@color/color_text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Developer Info -->
            <LinearLayout
                android:id="@+id/sidebar_action_devinfo"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_tools"
                    android:tint="@color/color_text_secondary"
                    android:layout_marginEnd="16dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sidebar_dev_info"
                    android:textColor="@color/color_text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/color_border" />

    <!-- ── Footer ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center"
        android:orientation="vertical"
        android:background="@color/color_background">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/toolbar_version"
            android:textColor="@color/color_accent_primary"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/toolbar_author"
            android:textColor="@color/color_text_secondary"
            android:textSize="9sp" />
    </LinearLayout>

</LinearLayout>
