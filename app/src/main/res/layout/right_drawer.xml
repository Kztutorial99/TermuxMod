<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/right_drawer"
    android:layout_width="268dp"
    android:layout_height="match_parent"
    android:layout_gravity="end"
    android:background="@color/color_surface_high"
    android:orientation="vertical"
    android:descendantFocusability="blocksDescendants">

    <!-- ── Header ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:background="@color/color_background">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/sidebar_title"
            android:textColor="@color/color_accent_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <ImageButton
            android:id="@+id/btn_close_right_drawer"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/color_text_secondary"
            android:contentDescription="Close sidebar" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/color_border" />

    <!-- ── Scrollable content ── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbarStyle="outsideOverlay">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- ════════════ PERANGKAT ════════════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sidebar_section_device"
                android:textColor="@color/color_accent_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.14"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="6dp" />

            <!-- Model perangkat -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sidebar_model"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/sidebar_info_model"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_text_primary"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:maxWidth="150dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="..." />
            </LinearLayout>

            <!-- Kernel version -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sidebar_kernel"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/sidebar_info_kernel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_text_primary"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:maxWidth="150dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="..." />
            </LinearLayout>

            <!-- ════════════ MEMORI & JARINGAN ════════════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sidebar_section_memory"
                android:textColor="@color/color_accent_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.14"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="6dp" />

            <!-- RAM bebas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sidebar_ram"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/sidebar_info_ram"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_text_primary"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:text="..." />
            </LinearLayout>

            <!-- Baterai -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sidebar_battery"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/sidebar_info_battery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_text_primary"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:text="..." />
            </LinearLayout>

            <!-- IP Address -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sidebar_ip"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/sidebar_info_ip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_text_primary"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:text="..." />
            </LinearLayout>

            <!-- ════════════ SISTEM INFO ════════════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sidebar_section_sysinfo"
                android:textColor="@color/color_accent_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.14"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="6dp" />

            <!-- Android version -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sidebar_android_version"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/sidebar_info_android"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_text_primary"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:text="..." />
            </LinearLayout>

            <!-- CPU Architecture -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sidebar_arch"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/sidebar_info_arch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_text_primary"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:text="..." />
            </LinearLayout>

            <!-- Free Storage -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sidebar_storage"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/sidebar_info_storage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_text_primary"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:text="..." />
            </LinearLayout>

            <!-- Prefix size -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sidebar_prefix"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/sidebar_info_prefix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_text_primary"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:text="..." />
            </LinearLayout>

            <!-- Active sessions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sidebar_sessions"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/sidebar_info_sessions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_accent_primary"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:text="0" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>


</LinearLayout>
