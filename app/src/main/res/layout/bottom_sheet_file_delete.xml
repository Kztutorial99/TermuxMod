<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/space_lg">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_marginBottom="@dimen/space_md"
        android:background="@drawable/shape_drag_handle" />

    <TextView
        android:id="@+id/file_delete_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_md"
        android:paddingEnd="@dimen/space_md"
        android:paddingBottom="@dimen/space_xs"
        android:textColor="@color/color_text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_md"
        android:paddingEnd="@dimen/space_md"
        android:paddingBottom="@dimen/space_lg"
        android:text="@string/file_delete_confirm_msg"
        android:textColor="@color/color_text_secondary"
        android:textSize="14sp"
        android:lineSpacingMultiplier="1.4" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_md"
        android:paddingEnd="@dimen/space_md">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_file_delete_cancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/space_sm"
            android:text="@android:string/cancel"
            android:textColor="@color/color_text_secondary"
            app:rippleColor="@color/color_ripple" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_file_delete_confirm"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/action_delete"
            app:backgroundTint="@color/color_accent_error"
            android:textColor="@color/white"
            app:cornerRadius="@dimen/radius_sm"
            app:rippleColor="@color/color_ripple" />

    </LinearLayout>

</LinearLayout>
