<?xml version="1.0" encoding="utf-8"?>
<!-- Pill handle tab — toggle button di atas extrakeys bar -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pill background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/color_surface_high" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <!-- Inner dash line (visual indicator) -->
    <item
        android:top="9dp"
        android:bottom="9dp"
        android:left="16dp"
        android:right="16dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/color_text_secondary" />
            <corners android:radius="2dp" />
        </shape>
    </item>

</layer-list>
